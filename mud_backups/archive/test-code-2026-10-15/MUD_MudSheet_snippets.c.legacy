// ---- DiagRead function
	//------------------------------------------------------------------------------------------------
	//! TEMP DIAG 2026-10-15 (dig leaves the mud, 0 cells moved): what the reads see at the middle of a dig box
	protected void DiagRead(float x, float z)
	{
		BaseWorld world = GetGame().GetWorld();
		float y = MUD_Surface.Get().Y(world, x, z);
		string hits = "";
		float top = y + 5;
		for (int h = 0; h < 4; h++)
		{
			TraceParam p = new TraceParam();
			p.Start = Vector(x, top, z);
			p.End = Vector(x, top - 15, z);
			p.Flags = TraceFlags.ENTS | TraceFlags.WORLD;
			p.LayerMask = EPhysicsLayerPresets.Projectile;
			float f = world.TraceMove(p, null);
			if (f >= 1)
				break;
			float hy = top - 15 * f;
			string cls = "terrain/world";
			if (p.TraceEnt)
				cls = p.TraceEnt.ClassName();
			hits += string.Format(" [%1 at %2]", cls, hy);
			top = hy - 0.01;
		}
		Print(string.Format("MUD mud sheet DIAG read at %1 %2: surfY %3, MUD_Surface.Y %4, OurY %5, hits down from Y+5:%6", x, z, world.GetSurfaceY(x, z), y, OurY(x, z), hits), LogLevel.NORMAL);
	}


// ---- RUT FPS members
	// TEMP RUT FPS 2026-10-15 (user: fps dips when the truck drives onto an old rut): frame time split by what the
	// nearest vehicle's wheels touch while it moves > 1 m/s - 0 rut (a wheel on a voxel brick), 1 our heightfield, 2 other
	protected int m_iGroundKind = -1;
	protected float m_fRutT;                           // plain members, not arrays (member array gotcha, mud-gotchas)
	protected float m_fOursT;
	protected float m_fOtherT;
	protected int m_iRutN;
	protected int m_iOursN;
	protected int m_iOtherN;
	protected int m_iRutWheelsMax;

// ---- RUT FPS frame count
			if (m_iGroundKind == 0)
			{
				m_fRutT += fdt;
				m_iRutN++;
			}
			else if (m_iGroundKind == 1)
			{
				m_fOursT += fdt;
				m_iOursN++;
			}
			else if (m_iGroundKind == 2)
			{
				m_fOtherT += fdt;
				m_iOtherN++;
			}

// ---- RUT FPS reset
		m_iGroundKind = -1;

// ---- RUT FPS wheel contact read
			// TEMP RUT FPS: this frame's wheel ground, counted with the next frame's dt
			VehicleWheeledSimulation rsim = VehicleWheeledSimulation.Cast(veh.FindComponent(VehicleWheeledSimulation));
			if (vph && rsim && vph.GetVelocity().Length() > 1)
			{
				int onRut = 0;
				int onOurs = 0;
				for (int rw = 0; rw < rsim.WheelCount(); rw++)
				{
					if (!rsim.WheelHasContact(rw))
						continue;
					IEntity ce = rsim.WheelGetContactEntity(rw);
					if (MUD_VoxelSubEntity.Cast(ce))
						onRut++;
					else if (MUD_FinePatchEntity.Cast(ce) || MUD_CoarseChunkEntity.Cast(ce))
						onOurs++;
				}
				m_iRutWheelsMax = Math.Max(m_iRutWheelsMax, onRut);
				if (onRut > 0)
					m_iGroundKind = 0;
				else if (onOurs > 0)
					m_iGroundKind = 1;
				else
					m_iGroundKind = 2;
			}

// ---- RUT FPS in PERF line
, m_fFrzT)
					+ string.Format(" | RUT FPS moving: on rut %1 fps (%2 s), our ground %3 fps (%4 s), other %5 fps (%6 s), most wheels on rut %7",
						m_iRutN / Math.Max(0.001, m_fRutT), m_fRutT, m_iOursN / Math.Max(0.001, m_fOursT), m_fOursT,
						m_iOtherN / Math.Max(0.001, m_fOtherT), m_fOtherT, m_iRutWheelsMax), LogLevel.NORMAL);

// ---- RUT FPS resets
			m_fRutT = 0;
			m_fOursT = 0;
			m_fOtherT = 0;
			m_iRutN = 0;
			m_iOursN = 0;
			m_iOtherN = 0;
			m_iRutWheelsMax = 0;

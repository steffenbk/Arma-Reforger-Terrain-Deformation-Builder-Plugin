//! Get out on mud ground: in a deep groove the vehicle sits lower than the ground beside it and the
//! animated get-out silently does nothing (2026-10-08, Exp 192624). If the animated get-out has not
//! started shortly after the press and the vehicle is on a MUD_GroundEntity, fall back to the teleport
//! get-out, which looks for a free spot around the vehicle with a downward trace (IDA, Stable WB
//! sub_140B3DEA0) and so lands on top of our ground. Off the mud nothing changes.
modded class SCR_GetOutAction
{
	protected static const int MUD_FALLBACK_DELAY_MS = 300;

	//------------------------------------------------------------------------------------------------
	override void PerformAction(IEntity pOwnerEntity, IEntity pUserEntity)
	{
		super.PerformAction(pOwnerEntity, pUserEntity);

		ChimeraCharacter character = ChimeraCharacter.Cast(pUserEntity);
		if (!pOwnerEntity || !character)
			return;

		IEntity root = pOwnerEntity.GetRootParent();
		if (!root || !MUD_GroundEntity.IsOnAnyGround(root.GetOrigin()))
			return;

		// the animated get-out may set IsGettingOut a frame later: check after a short delay
		GetGame().GetCallqueue().CallLater(MudGetOutFallback, MUD_FALLBACK_DELAY_MS, false, character, GetRelevantDoorIndex(pUserEntity));
	}

	//------------------------------------------------------------------------------------------------
	protected void MudGetOutFallback(ChimeraCharacter character, int doorIndex)
	{
		if (!character)
			return;

		CompartmentAccessComponent access = character.GetCompartmentAccessComponent();
		if (!access || !access.IsInCompartment() || access.IsGettingOut() || access.IsGettingIn())
			return;

		CharacterControllerComponent controller = character.GetCharacterController();
		if (controller && controller.IsUnconscious())
			return;

		bool ok = access.GetOutVehicle(EGetOutType.TELEPORT, doorIndex, ECloseDoorAfterActions.INVALID, false);
		Print(string.Format("MUD ground: animated get out did not start on mud, teleport fallback %1", ok), LogLevel.WARNING);
	}
}

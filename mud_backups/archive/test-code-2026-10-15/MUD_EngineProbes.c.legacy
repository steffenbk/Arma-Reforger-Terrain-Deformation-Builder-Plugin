//! TEMP probe 2026-10-14 (papers plan Step G, after the IDA study). SP only, runs once per play, by time:
//!  G1 (10 s): three domes 6 m ahead of the player, each 8 x 4 m, peak on x = 0. OFF = two meshes split at the
//!     peak (the engine's normals at the split see one side only: expect a light crease), ON = the same split, each
//!     half also holding 1 mm copies of the other half's triangles at the split (IDA: every face counts with
//!     weight 1, size does not matter), WHOLE = one mesh (the truth). ON should look like WHOLE.
//!  G2 (15 s / 22 s): a two-section mesh, control with two materials, then the same material twice. IDA: Create
//!     de-dups materials by name, so the second section has no slot - suspected cause of the 2026-10-10 skirt
//!     crash. Each step prints before it runs; after a crash the last 'MUD G2' line in the log says where.
//!  G3 (30 s): collider patch vs full rebuild, 50 m under the player: K full rebuilds (Destroy + CreateTriMesh +
//!     CreateStaticEx) against K patches (CreateTriMesh + AddGeom + SetGeomInteractionLayer(old, 0)). Each new
//!     piece sits 1 cm LOWER, so a downward trace only hits the newest piece if the old ones are really off.
class MUD_EngineProbes
{
	static const bool ENABLED = false;   // Step G done 2026-10-14 (results/2026-10-14-engine-probes.md)
	static const bool RUN_G1 = true;
	static const bool RUN_G2 = false;   // PROVEN 2026-10-14 20:18: same emat twice crashes (results/2026-10-14-engine-probes.md)
	static const bool RUN_G3 = true;
	static const int G3_K = 200;                // repeats per method and grid size

	protected static float s_fLast = -1;
	protected static float s_fStart = -1;
	protected static int s_iStep;
	protected static vector s_vOrg;
	protected static ref array<ref Resource> s_aRes = {};      // keeps the probe meshes alive
	protected static ref array<IEntity> s_aEnts = {};
	protected static IEntity s_G2Ent;
	protected static ref MUD_EngineProbeBuf s_B = new MUD_EngineProbeBuf();

	//------------------------------------------------------------------------------------------------
	//! Called every frame from MUD_WorldGround (time = its m_fTime, back to 0 at each play)
	static void Tick(float time)
	{
		if (!ENABLED)
			return;
		if (RplSession.Mode() == RplMode.Dedicated || RplSession.Mode() == RplMode.Client)
			return;
		if (time < s_fLast)
		{
			// new play: the old entities went with the old world
			s_fStart = -1;
			s_iStep = 0;
			s_aRes.Clear();
			s_aEnts.Clear();
			s_G2Ent = null;
		}
		s_fLast = time;
		if (s_iStep >= 9)
			return;
		IEntity pl = SCR_PlayerController.GetLocalControlledEntity();
		if (!pl)
			return;
		if (s_fStart < 0)
			s_fStart = time;
		float t = time - s_fStart;
		if (s_iStep == 0 && t >= 10)
		{
			s_iStep = 1;
			if (RUN_G1)
				G1(pl);
		}
		else if (s_iStep == 1 && t >= 15)
		{
			s_iStep = 2;
			if (RUN_G2)
				G2Make(pl, false);
		}
		else if (s_iStep == 2 && t >= 17)
		{
			s_iStep = 3;
			if (RUN_G2)
				G2Again("control");
		}
		else if (s_iStep == 3 && t >= 20)
		{
			s_iStep = 4;
			if (RUN_G2)
				Print("MUD G2 control: survived 5 s", LogLevel.NORMAL);
		}
		else if (s_iStep == 4 && t >= 22)
		{
			s_iStep = 5;
			if (RUN_G2)
				G2Make(pl, true);
		}
		else if (s_iStep == 5 && t >= 24)
		{
			s_iStep = 6;
			if (RUN_G2)
				G2Again("same material");
		}
		else if (s_iStep == 6 && t >= 27)
		{
			s_iStep = 7;
			if (RUN_G2)
				Print("MUD G2 same material: survived 5 s", LogLevel.NORMAL);
		}
		else if (s_iStep == 7 && t >= 30)
		{
			s_iStep = 8;
			if (RUN_G3)
			{
				vector org = pl.GetOrigin() - Vector(0, 50, 0);
				G3(org, 8);
				G3(org + Vector(6, 0, 0), 32);
			}
		}
		else if (s_iStep == 8)
		{
			s_iStep = 9;
			Print("MUD engine probes: all done", LogLevel.NORMAL);
		}
	}

	//------------------------------------------------------------------------------------------------
	protected static IEntity Spawn(vector pos)
	{
		EntitySpawnParams params = new EntitySpawnParams();
		params.TransformMode = ETransformMode.WORLD;
		params.Transform[0] = vector.Right;
		params.Transform[1] = vector.Up;
		params.Transform[2] = vector.Forward;
		params.Transform[3] = pos;
		IEntity ent = GetGame().SpawnEntity(MUD_VoxelSubEntity, GetGame().GetWorld(), params);
		if (ent)
			s_aEnts.Insert(ent);
		return ent;
	}

	//------------------------------------------------------------------------------------------------
	//! Ground height under pos: a trace down (our ground is a script body over a holed heightmap, so GetSurfaceY
	//! is wrong there); the player's height when nothing is hit
	protected static float GroundY(vector pos, IEntity pl)
	{
		TraceParam p = new TraceParam();
		p.Start = Vector(pos[0], pl.GetOrigin()[1] + 20, pos[2]);
		p.End = Vector(pos[0], pl.GetOrigin()[1] - 20, pos[2]);
		p.Flags = TraceFlags.ENTS | TraceFlags.WORLD;
		p.LayerMask = EPhysicsLayerPresets.Projectile;
		p.Exclude = pl;
		float f = GetGame().GetWorld().TraceMove(p, null);
		if (f >= 1)
			return pl.GetOrigin()[1];
		return p.Start[1] + (p.End[1] - p.Start[1]) * f;
	}

	//------------------------------------------------------------------------------------------------
	//! G1 dome height at local x (-4..4), z (0..4)
	protected static float DomeH(float x, float z)
	{
		return 1.2 * Math.Pow(2.718282, -(x * x + (z - 2) * (z - 2)) / 1.5);
	}

	//------------------------------------------------------------------------------------------------
	protected static void G1(IEntity pl)
	{
		vector o = pl.GetOrigin();
		array<string> names = {"OFF", "ON", "WHOLE"};
		for (int si = 0; si < 3; si++)
		{
			vector org = o + Vector(0, 0, 6 + si * 6);
			org[1] = GroundY(org, pl) + 0.05;
			int made = 0;
			int tiny = 0;
			if (si == 2)
			{
				tiny += G1Piece(org, 0, 16, false);
				made = 1;
			}
			else
			{
				tiny += G1Piece(org, 0, 8, si == 1);
				tiny += G1Piece(org, 8, 16, si == 1);
				made = 2;
			}
			Print(string.Format("MUD G1 %1: %2 mesh(es) at %3, %4 tiny triangles", names[si], made, org, tiny), LogLevel.NORMAL);
		}
	}

	//------------------------------------------------------------------------------------------------
	//! One dome mesh over grid columns i0..i1 (0..16, 0.5 m, i = 8 is the peak line), rows k 0..8. extra: also the
	//! 1 mm copies of the other half's triangles that touch the split column. Returns the tiny triangle count.
	protected static int G1Piece(vector org, int i0, int i1, bool extra)
	{
		int cols = i1 - i0 + 1;
		int nv = 0;
		for (int k = 0; k <= 8; k++)
		{
			for (int i = i0; i <= i1; i++)
			{
				float x = i * 0.5 - 4;
				float z = k * 0.5;
				s_B.m_aV[nv] = Vector(x, DomeH(x, z), z);
				s_B.m_aUV[nv * 2] = (i - i0) / (cols - 1.0);
				s_B.m_aUV[nv * 2 + 1] = k / 8.0;
				nv++;
			}
		}
		int ni = 0;
		for (int k2 = 0; k2 < 8; k2++)
		{
			for (int i2 = i0; i2 < i1; i2++)
			{
				int a = k2 * cols + i2 - i0;
				int b = a + 1;
				int c = a + cols;
				int d = c + 1;
				// a c d / a d b: upward (as MUD_VoxelProbe.Quad + Tri)
				s_B.m_aI[ni++] = a;
				s_B.m_aI[ni++] = c;
				s_B.m_aI[ni++] = d;
				s_B.m_aI[ni++] = a;
				s_B.m_aI[ni++] = d;
				s_B.m_aI[ni++] = b;
			}
		}
		int tiny = 0;
		if (extra)
		{
			// the other half's cells next to the split (i 7..8 for the right half, 8..9 for the left), the same two
			// triangles per cell; each corner on the split column keeps its own vertex index, the other two corners
			// become new vertices 1 mm from it along the true edges (same face normal, ~0 area)
			int cellI = 8;  // left half owns columns 0..8: the other side's cells are i 8..9
			if (i0 == 8)
				cellI = 7;  // right half: the other side's cells are i 7..8
			for (int k3 = 0; k3 < 8; k3++)
			{
				vector pa = GridP(cellI, k3);
				vector pb = GridP(cellI + 1, k3);
				vector pc = GridP(cellI, k3 + 1);
				vector pd = GridP(cellI + 1, k3 + 1);
				int ia = GridIdx(cellI, k3, i0, i1);
				int ib = GridIdx(cellI + 1, k3, i0, i1);
				int ic = GridIdx(cellI, k3 + 1, i0, i1);
				int id = GridIdx(cellI + 1, k3 + 1, i0, i1);
				tiny += TinyTri(pa, pc, pd, ia, ic, id, nv, ni);
				tiny += TinyTri(pa, pd, pb, ia, id, ib, nv, ni);
			}
		}
		int nvs[1];
		int nis[1];
		string mats[1];
		nvs[0] = nv;
		nis[0] = ni;
		mats[0] = MUD_VoxelProbe.MAT_TOP;
		Resource res = MeshObject.Create(1, nvs, nis, mats, 0);
		if (!res || !res.GetResource())
		{
			Print("MUD G1: MeshObject.Create failed", LogLevel.ERROR);
			return tiny;
		}
		MeshObject mesh = res.GetResource().ToMeshObject();
		mesh.UpdateIndices(0, s_B.m_aI);
		mesh.UpdateVerts(0, s_B.m_aV, s_B.m_aUV);
		IEntity ent = Spawn(org);
		if (!ent)
			return tiny;
		ent.SetObject(mesh, "");
		ent.Update();
		s_aRes.Insert(res);
		return tiny;
	}

	//------------------------------------------------------------------------------------------------
	protected static vector GridP(int i, int k)
	{
		float x = i * 0.5 - 4;
		float z = k * 0.5;
		return Vector(x, DomeH(x, z), z);
	}

	//------------------------------------------------------------------------------------------------
	//! Vertex index of grid point i, k in a piece over columns i0..i1, -1 when the piece does not have it
	protected static int GridIdx(int i, int k, int i0, int i1)
	{
		if (i < i0 || i > i1)
			return -1;
		return k * (i1 - i0 + 1) + i - i0;
	}

	//------------------------------------------------------------------------------------------------
	//! For each corner the piece has (index >= 0): a 1 mm copy of triangle p0 p1 p2 around that corner, using its
	//! real index and two new vertices. Adds to s_B (nv, ni). Returns the triangles added.
	protected static int TinyTri(vector p0, vector p1, vector p2, int i0, int i1, int i2, inout int nv, inout int ni)
	{
		vector p[3];
		p[0] = p0;
		p[1] = p1;
		p[2] = p2;
		int ix[3];
		ix[0] = i0;
		ix[1] = i1;
		ix[2] = i2;
		int n = 0;
		for (int s = 0; s < 3; s++)
		{
			if (ix[s] < 0)
				continue;
			int t[3];
			for (int c = 0; c < 3; c++)
			{
				if (c == s)
				{
					t[c] = ix[s];
					continue;
				}
				vector q = p[s] + (p[c] - p[s]).Normalized() * 0.001;
				s_B.m_aV[nv] = q;
				s_B.m_aUV[nv * 2] = 0.5;
				s_B.m_aUV[nv * 2 + 1] = 0.5;
				t[c] = nv;
				nv++;
			}
			s_B.m_aI[ni++] = t[0];
			s_B.m_aI[ni++] = t[1];
			s_B.m_aI[ni++] = t[2];
			n++;
		}
		return n;
	}

	//------------------------------------------------------------------------------------------------
	//! G2: a 2-section mesh 3 m ahead (section 1 is 0.5 m higher), materials TOP + DIRT (control) or DIRT twice
	protected static void G2Make(IEntity pl, bool same)
	{
		string tag = "control";
		string m1 = MUD_VoxelProbe.MAT_DIRT;
		string m0 = MUD_VoxelProbe.MAT_TOP;
		if (same)
		{
			tag = "same material";
			m0 = MUD_VoxelProbe.MAT_DIRT;
		}
		vector org = pl.GetOrigin() + Vector(3, 0, 0);
		org[1] = GroundY(org, pl) + 0.3;
		Print(string.Format("MUD G2 %1: Create (2 sections, %2 + %3)", tag, m0, m1), LogLevel.NORMAL);
		int nvs[] = {4, 4};
		int nis[] = {12, 12};
		string mats[2];
		mats[0] = m0;
		mats[1] = m1;
		Resource res = MeshObject.Create(2, nvs, nis, mats, 0);
		if (!res || !res.GetResource())
		{
			Print(string.Format("MUD G2 %1: Create returned null", tag), LogLevel.NORMAL);
			return;
		}
		s_aRes.Insert(res);
		MeshObject mesh = res.GetResource().ToMeshObject();
		Print(string.Format("MUD G2 %1: Create ok, update section 0", tag), LogLevel.NORMAL);
		G2Upload(mesh, 0, 0);
		Print(string.Format("MUD G2 %1: section 0 ok, update section 1", tag), LogLevel.NORMAL);
		G2Upload(mesh, 1, 0.5);
		Print(string.Format("MUD G2 %1: section 1 ok, spawn + SetObject", tag), LogLevel.NORMAL);
		s_G2Ent = Spawn(org);
		if (!s_G2Ent)
			return;
		s_G2Ent.SetObject(mesh, "");
		s_G2Ent.Update();
		Print(string.Format("MUD G2 %1: SetObject ok at %2 (look 3 m to the side of the player)", tag, org), LogLevel.NORMAL);
	}

	//------------------------------------------------------------------------------------------------
	//! G2: the same mesh updated again 2 s later (both sections moved up 0.2 m), as a rebuild would
	protected static void G2Again(string tag)
	{
		if (!s_G2Ent || s_aRes.IsEmpty())
			return;
		MeshObject mesh = s_aRes[s_aRes.Count() - 1].GetResource().ToMeshObject();
		Print(string.Format("MUD G2 %1: second update", tag), LogLevel.NORMAL);
		G2Upload(mesh, 0, 0.2);
		G2Upload(mesh, 1, 0.7);
		s_G2Ent.SetObject(mesh, "");
		s_G2Ent.Update();
		Print(string.Format("MUD G2 %1: second update ok", tag), LogLevel.NORMAL);
	}

	//------------------------------------------------------------------------------------------------
	//! A 2 x 2 m quad at height h, both windings (seen from above and below)
	protected static void G2Upload(MeshObject mesh, int section, float h)
	{
		vector v[4];
		v[0] = Vector(0, h, 0);
		v[1] = Vector(2, h, 0);
		v[2] = Vector(0, h, 2);
		v[3] = Vector(2, h, 2);
		float uv[] = {0, 0, 1, 0, 0, 1, 1, 1};
		int idx[] = {0, 2, 3, 0, 3, 1, 0, 3, 2, 0, 1, 3};
		mesh.UpdateIndices(section, idx);
		mesh.UpdateVerts(section, v, uv);
	}

	//------------------------------------------------------------------------------------------------
	//! A flat 4 x 4 m grid of n x n quads at height h into s_B (entity local); returns the index count
	protected static int G3Grid(int n, float h)
	{
		int nv = 0;
		for (int k = 0; k <= n; k++)
		{
			for (int i = 0; i <= n; i++)
			{
				s_B.m_aV[nv] = Vector(i * 4.0 / n, h, k * 4.0 / n);
				nv++;
			}
		}
		int ni = 0;
		for (int k2 = 0; k2 < n; k2++)
		{
			for (int i2 = 0; i2 < n; i2++)
			{
				int a = k2 * (n + 1) + i2;
				s_B.m_aI[ni++] = a;
				s_B.m_aI[ni++] = a + n + 1;
				s_B.m_aI[ni++] = a + n + 2;
				s_B.m_aI[ni++] = a;
				s_B.m_aI[ni++] = a + n + 2;
				s_B.m_aI[ni++] = a + 1;
			}
		}
		return ni;
	}

	//------------------------------------------------------------------------------------------------
	//! Height (world y) of the first hit straight down through the middle of the G3 grid at org, or -99999
	protected static float G3Trace(vector org, IEntity ent)
	{
		TraceParam p = new TraceParam();
		p.Start = org + Vector(2.1, 3, 1.9);
		p.End = org + Vector(2.1, -6, 1.9);
		p.Flags = TraceFlags.ENTS;
		p.LayerMask = EPhysicsLayerPresets.Projectile;
		float f = GetGame().GetWorld().TraceMove(p, null);
		if (f >= 1 || p.TraceEnt != ent)
			return -99999;
		return p.Start[1] + (p.End[1] - p.Start[1]) * f;
	}

	//------------------------------------------------------------------------------------------------
	protected static void G3(vector org, int n)
	{
		int layer = EPhysicsLayerPresets.Terrain | EPhysicsLayerDefs.Foliage;
		string gm = MUD_VoxelProbe.GAMEMAT;
		int nv = (n + 1) * (n + 1);
		int tris = n * n * 2;
		IEntity ent = Spawn(org);
		if (!ent)
			return;
		// traces skip an entity without a mesh (point bounds, mud-gotchas / MUD_BoundsMesh.c)
		Resource bres = MUD_BoundsMesh.Make(ent, Vector(0, -4, 0), Vector(4, 1, 4), MUD_VoxelProbe.MAT_DIRT);
		if (bres)
			s_aRes.Insert(bres);

		// grid fill alone (in both loops below)
		int t0 = System.GetTickCount();
		for (int r0 = 0; r0 < G3_K; r0++)
			G3Grid(n, -0.01 * r0);
		int msFill = System.GetTickCount(t0);

		// A: full rebuild K times
		Physics phys;
		PhysicsGeom g;
		int t1 = System.GetTickCount();
		for (int r = 0; r < G3_K; r++)
		{
			if (phys)
				phys.Destroy();
			if (g)
				g.Destroy();
			int ni = G3Grid(n, -0.01 * r);
			g = PhysicsGeom.CreateTriMesh(s_B.m_aV, s_B.m_aI, nv, ni);
			autoptr PhysicsGeomDef d[] = {PhysicsGeomDef("", g, gm, layer)};
			phys = Physics.CreateStaticEx(ent, d);
		}
		int msFull = System.GetTickCount(t1);
		float yFull = G3Trace(org, ent);
		float wantFull = org[1] - 0.01 * (G3_K - 1);
		if (phys)
			phys.Destroy();
		if (g)
			g.Destroy();

		// B: one body, then K patches (new piece in, old piece off)
		array<PhysicsGeom> geoms = {};
		int ni0 = G3Grid(n, 0);
		PhysicsGeom g0 = PhysicsGeom.CreateTriMesh(s_B.m_aV, s_B.m_aI, nv, ni0);
		geoms.Insert(g0);
		autoptr PhysicsGeomDef d0[] = {PhysicsGeomDef("", g0, gm, layer)};
		phys = Physics.CreateStaticEx(ent, d0);
		if (!phys)
		{
			Print("MUD G3: body failed", LogLevel.ERROR);
			return;
		}
		float yFirst = G3Trace(org, ent);
		vector frame[4];
		frame[0] = vector.Right;
		frame[1] = vector.Up;
		frame[2] = vector.Forward;
		frame[3] = vector.Zero;
		int old = 0;
		int bad = 0;
		int msFirst = 0;
		int msLast = 0;
		int lastIdx = -1;
		int t2 = System.GetTickCount();
		int tb = t2;
		for (int r2 = 1; r2 <= G3_K; r2++)
		{
			int ni2 = G3Grid(n, -0.01 * r2);
			PhysicsGeom gn = PhysicsGeom.CreateTriMesh(s_B.m_aV, s_B.m_aI, nv, ni2);
			geoms.Insert(gn);
			int gi = phys.AddGeom("", gn, frame, gm, layer);
			if (gi < 0)
			{
				bad++;
				continue;
			}
			phys.SetGeomInteractionLayer(old, 0);
			old = gi;
			lastIdx = gi;
			if (r2 == 50)
				msFirst = System.GetTickCount(tb);
			if (r2 == G3_K - 50)
				tb = System.GetTickCount();
		}
		msLast = System.GetTickCount(tb);
		int msPatch = System.GetTickCount(t2);
		float yPatch = G3Trace(org, ent);
		float wantPatch = org[1] - 0.01 * G3_K;
		phys.Destroy();
		foreach (PhysicsGeom pg : geoms)
		{
			if (pg)
				pg.Destroy();
		}
		float eachFull = msFull;
		eachFull /= G3_K;
		float eachPatch = msPatch;
		eachPatch /= G3_K;
		Print(string.Format("MUD G3 grid %1 (%2 tris), K %3: fill only %4 ms, full rebuild %5 ms (%6 ms each), patch %7 ms (%8 ms each)",
			n, tris, G3_K, msFill, msFull, eachFull, msPatch, eachPatch), LogLevel.NORMAL);
		Print(string.Format("MUD G3 grid %1: patch first 50 %2 ms, last 50 %3 ms, AddGeom failed %4, last index %5",
			n, msFirst, msLast, bad, lastIdx), LogLevel.NORMAL);
		Print(string.Format("MUD G3 grid %1: trace first body %2 (want %3), after rebuilds %4 (want %5), after patches %6 (want %7; %8 = old pieces still on)",
			n, yFirst, org[1], yFull, wantFull, yPatch, wantPatch, org[1]), LogLevel.NORMAL);
	}
}

//! G1 / G3 buffers (MeshObject and CreateTriMesh take static arrays)
class MUD_EngineProbeBuf
{
	vector m_aV[1100];      // G3 grid 32: 1089; G1: 153 + 2 per tiny triangle
	float m_aUV[2200];
	int m_aI[6200];         // G3 grid 32: 6144
}

//! TEMP probe (2026-10-12): does VehicleWheeledSimulation.WheelSetRadiusState move the suspension / body,
//! or only the rolling radius? Decides the "radius ruts" idea (tyre shrinks instead of the ground dropping).
//! Start: sit in the driver seat, stand still 5 s. No key needed. Runs once per get-in.
//!  t 0 s: shrink wheel 0 by SHRINK m (body woken first, so a parked sleeping body can't fake a "no").
//!  t 3 s: put the radius back.  t 6 s: done.
//! Log: 'MUD radius' lines every 0.1 s: radius state per wheel, wheel 0 contact y + hub y, body y, body up vector.
//! Delete this file when done (nothing else calls it).
class MUD_RadiusProbe
{
	static const bool ON = false;   // off for the server test (user 2026-10-13)
	protected static const float SHRINK = 0.1;
	protected static const float ARM_SEC = 5;
	protected static const float RESTORE_SEC = 3;
	protected static const float END_SEC = 6;
	protected static const float LOG_SEC = 0.1;

	protected static Vehicle s_Veh;
	protected static float s_fStill;
	protected static bool s_bRun;
	protected static bool s_bDone;
	protected static bool s_bRestored;
	protected static float s_fT;
	protected static float s_fNextLog;
	protected static float s_fR0;

	//------------------------------------------------------------------------------------------------
	static void Tick(IEntity me, float dt)
	{
		Vehicle veh;
		bool driver;
		if (me)
		{
			veh = Vehicle.Cast(CompartmentAccessComponent.GetVehicleIn(me));
			CompartmentAccessComponent cac = CompartmentAccessComponent.Cast(me.FindComponent(CompartmentAccessComponent));
			if (veh && cac && PilotCompartmentSlot.Cast(cac.GetCompartment()))
				driver = true;
		}
		if (!driver)
		{
			if (s_bRun && s_Veh)
				Restore("left the driver seat");
			s_bRun = false;
			s_bDone = false;
			s_fStill = 0;
			s_Veh = null;
			return;
		}

		VehicleWheeledSimulation sim = VehicleWheeledSimulation.Cast(veh.FindComponent(VehicleWheeledSimulation));
		if (!sim || !sim.IsValid() || sim.WheelCount() < 1 || !veh.GetPhysics())
			return;

		if (!s_bRun)
		{
			if (s_bDone)
				return;
			if (veh.GetPhysics().GetVelocity().Length() > 0.1)
			{
				s_fStill = 0;
				return;
			}
			s_fStill += dt;
			if (s_fStill < ARM_SEC)
				return;
			s_bRun = true;
			s_bRestored = false;
			s_Veh = veh;
			s_fT = 0;
			s_fNextLog = 0;
			s_fR0 = sim.WheelGetRadiusState(0);
			Print(string.Format("MUD radius START %1 wheel 0 '%2' radius init %3 state %4 | server %5 | body active %6",
				veh.GetID(), sim.WheelGetName(0), sim.WheelGetRadius(0), s_fR0, Replication.IsServer(), veh.GetPhysics().IsActive()));
			Log(sim, veh, "before");
			veh.GetPhysics().SetActive(ActiveState.ACTIVE);
			float ret = sim.WheelSetRadiusState(0, s_fR0 - SHRINK);
			Print(string.Format("MUD radius SET wheel 0 to %1 (setter returned %2), read back now %3", s_fR0 - SHRINK, ret, sim.WheelGetRadiusState(0)));
			return;
		}

		s_fT += dt;
		if (!s_bRestored && s_fT >= RESTORE_SEC)
		{
			s_bRestored = true;
			veh.GetPhysics().SetActive(ActiveState.ACTIVE);
			sim.WheelSetRadiusState(0, s_fR0);
			Print(string.Format("MUD radius RESTORE wheel 0 to %1 at %2 s, read back now %3", s_fR0, s_fT, sim.WheelGetRadiusState(0)));
		}
		if (s_fT >= s_fNextLog)
		{
			s_fNextLog += LOG_SEC;
			string phase = "shrunk";
			if (s_bRestored)
				phase = "restored";
			Log(sim, veh, phase);
		}
		if (s_fT >= END_SEC)
		{
			Print("MUD radius END");
			s_bRun = false;
			s_bDone = true;
		}
	}

	//------------------------------------------------------------------------------------------------
	protected static void Log(VehicleWheeledSimulation sim, Vehicle veh, string phase)
	{
		string radii;
		for (int w = 0; w < sim.WheelCount(); w++)
		{
			radii += " " + sim.WheelGetRadiusState(w).ToString(-1, 3);
		}
		vector mat[4];
		veh.GetWorldTransform(mat);
		vector hub = sim.WheelGetPosition(0);
		vector hubW = veh.CoordToParent(hub);
		Print(string.Format("MUD radius t %1 %2 | radius state%3 | w0 contact %4 y %5 | w0 hub local %6 world y %7 | body y %8 up %9",
			s_fT.ToString(-1, 2), phase, radii, sim.WheelHasContact(0), sim.WheelGetContactPosition(0)[1].ToString(-1, 3),
			hub, hubW[1].ToString(-1, 3), mat[3][1].ToString(-1, 3), mat[1]));
	}

	//------------------------------------------------------------------------------------------------
	protected static void Restore(string why)
	{
		VehicleWheeledSimulation sim = VehicleWheeledSimulation.Cast(s_Veh.FindComponent(VehicleWheeledSimulation));
		if (sim && sim.IsValid())
			sim.WheelSetRadiusState(0, s_fR0);
		Print("MUD radius ABORT (" + why + "), radius put back");
	}
}

//------------------------------------------------------------------------------------------------
//! TEMP (MUD_RadiusProbe): ticks the probe for the local player
modded class SCR_CharacterControllerComponent
{
	//------------------------------------------------------------------------------------------------
	override void OnPrepareControls(IEntity owner, ActionManager am, float dt, bool player)
	{
		if (player && MUD_RadiusProbe.ON)
			MUD_RadiusProbe.Tick(owner, dt);
		super.OnPrepareControls(owner, am, dt, player);
	}
}

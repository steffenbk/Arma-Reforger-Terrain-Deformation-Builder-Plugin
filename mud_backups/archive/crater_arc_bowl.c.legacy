// ----
	//------------------------------------------------------------------------------------------------
	//! Arc bowl at distance d from the centre, 0 at the bottom .. 1 at the crest: floor arc (radius rb),
	//! straight wall at angle th, crest arc (radius rt). Same math as Tools/crater_profile.py arc_rise.
	protected static float ArcRise(float d, float rb, float rt, float wall, float nat, float th)
	{
		float total = (rb + rt) * (1 - Math.Cos(th)) + wall * Math.Tan(th);
		if (total <= 0)
			return 1;
		float xb = rb * Math.Sin(th);
		float y;
		if (d <= xb)
		{
			y = rb - Math.Sqrt(Math.Max(rb * rb - d * d, 0));
		}
		else if (d <= xb + wall)
		{
			y = rb * (1 - Math.Cos(th)) + (d - xb) * Math.Tan(th);
		}
		else
		{
			float u = Math.Max(nat - d, 0);
			y = total - (rt - Math.Sqrt(Math.Max(rt * rt - u * u, 0)));
		}
		return Math.Clamp(y / total, 0, 1);
	}



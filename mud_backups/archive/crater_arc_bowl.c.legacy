			arcT = Math.Max(m_fCraterCrestRadius, 0) * kr;
			arcTh = Math.Atan2(slope, 1);
			float sr = Math.Max(arcB + arcT, 0.01);
			if (rise < sr * (1 - Math.Cos(arcTh)))
				arcTh = Math.Acos(1 - rise / sr);
			else
				arcWall = (rise - sr * (1 - Math.Cos(arcTh))) / Math.Tan(arcTh);
			arcNat = sr * Math.Sin(arcTh) + arcWall;
			crest = Math.Max(3 * m_fFine, arcNat);
		}
		else
		{
			crest = Math.Max(3 * m_fFine, (depth + rim) * Math.PI / (2 * slope));
		}


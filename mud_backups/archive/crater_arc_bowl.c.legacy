	[Attribute("0", UIWidgets.EditBox, "Crater floor bend radius (m): bigger = flatter bottom, easier to lie in. 0 = old cosine bowl", category: "Craters")]
	protected float m_fCraterFloorRadius;

	[Attribute("2.0", UIWidgets.EditBox, "Crater crest bend radius (m) where the wall rounds into the rim", category: "Craters")]
	protected float m_fCraterCrestRadius;

	[Attribute("1.2", UIWidgets.EditBox, "Craters shallower than this (depth + rim, m) shrink both bend radii, so small ones keep their size", category: "Craters")]
	protected float m_fCraterArcRef;

// ----
		float crest;

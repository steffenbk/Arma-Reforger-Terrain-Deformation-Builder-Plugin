//------------------------------------------------------------------------------------------------
//! Every explosion in the game goes through an ExplosionDamageContainer (ammo warheads, hand grenades,
//! mines, demo charges, vehicle ammo-rack / fuel blasts, fires; pak 2026-10-10). The older hook,
//! SCR_ExplosionAmmoEffect, sits on only 13 vanilla ammo prefabs. This hands each one to the world
//! ground, which reads the charge from the prefab and decides the crater (MUD_WorldGround.c Blast).
modded class ExplosionDamageContainer
{
	//------------------------------------------------------------------------------------------------
	override void OnEffect(IEntity pHitEntity, inout vector outMat[3], IEntity damageSource, notnull Instigator instigator, string colliderName, float speed)
	{
		super.OnEffect(pHitEntity, outMat, damageSource, instigator, colliderName, speed);
		MUD_WorldGroundEntity ground = MUD_WorldGroundEntity.GetInstance();
		if (ground)
			ground.OnContainerBlast(pHitEntity, outMat[0], damageSource);
	}
}

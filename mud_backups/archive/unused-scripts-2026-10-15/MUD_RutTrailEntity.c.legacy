[EntityEditorProps(category: "Mud", description: "Rut trail test - wheels leave strip meshes behind them, anywhere near the camera", color: "120 80 40 255")]
class MUD_RutTrailEntityClass : GenericEntityClass
{
}

//! Index buffer in its own object: script classes hold at most 256KB of members.
class MUD_RutTrailIndices
{
	int m_aIndices[36000]; // MAX_SECTIONS * 4 quads * 6
}

//! Per-wheel chain state
class MUD_RutWheel
{
	vector m_vLast;
	int m_iSlot = -1;   // last section this wheel laid, -1 = chain broken
	int m_iSerial;
	float m_fDist;      // distance along the chain, drives the V coordinate
}

class MUD_RutVehicle
{
	IEntity m_Ent;
	ref array<ref MUD_RutWheel> m_aWheels = {};
}

//! Visual-only rut trails. Instead of a deformable blanket, every wheel with ground
//! contact lays a cross-section every m_fStep metres; consecutive sections of one
//! wheel are joined into a strip: flat centre, raised berms, edges back on the ground.
//! The terrain is drawn over anything below it, so the rut look comes from the berms
//! rising, not from a dip.
//! Sections live in a ring buffer; the oldest are reused when it is full.
//! Mesh is static (flags 0) and rebuilt when something changed - DYNAMIC_VERTEXES
//! shades scaly (proven 2026-10-07), static + rebuild shades correctly.
class MUD_RutTrailEntity : GenericEntity
{
	static const int MAX_SECTIONS = 1500;
	static const int SECTION_VERTS = 5;

	[Attribute("60", UIWidgets.EditBox, "Only vehicles this close to the CAMERA leave ruts (m) - far away nobody sees the depth", category: "Mud")]
	protected float m_fRadius;

	[Attribute("0.3", UIWidgets.EditBox, "Distance between cross-sections (m)", category: "Mud")]
	protected float m_fStep;

	[Attribute("0.15", UIWidgets.EditBox, "Half width of the flat rut centre (m)", category: "Mud")]
	protected float m_fRutHalfWidth;

	[Attribute("0.4", UIWidgets.EditBox, "Half width of the whole strip, berm edge to berm edge (m)", category: "Mud")]
	protected float m_fStripHalfWidth;

	[Attribute("0.06", UIWidgets.EditBox, "Berm height above the ground (m)", category: "Mud")]
	protected float m_fBermHeight;

	[Attribute("0.015", UIWidgets.EditBox, "Rut centre / edge height above the ground, avoids z-fighting (m)", category: "Mud")]
	protected float m_fGroundOffset;

	[Attribute("2", UIWidgets.EditBox, "Strip length one texture repeat covers (m)", category: "Mud")]
	protected float m_fTexLength;

	[Attribute("0.1", UIWidgets.EditBox, "Min seconds between mesh rebuilds", category: "Mud")]
	protected float m_fRebuildInterval;

	// MeshObject.Create returns null if the material fails to load
	[Attribute("{A29AE750B3F1E371}Assets/Mud/Data/Mud.emat", UIWidgets.ResourcePickerThumbnail, "Material on the strips", "emat", category: "Mud")]
	protected ResourceName m_Material;

	[Attribute("1", UIWidgets.CheckBox, "Print debug info", category: "Mud")]
	protected bool m_bDebug;

	protected vector m_aVerts[7500];  // MAX_SECTIONS * SECTION_VERTS
	protected float m_aUVs[15000];
	protected int m_aSerial[1500];    // bumps each time a slot is (re)written
	protected int m_aPrevSlot[1500];  // section this one connects back to, -1 = chain start
	protected int m_aPrevSerial[1500];

	protected ref MUD_RutTrailIndices m_Indices;
	protected ref Resource m_MeshRes;
	protected ref array<IEntity> m_aFound = {};
	protected ref array<ref MUD_RutVehicle> m_aVehicles = {};
	protected int m_iNext;      // next ring slot to write
	protected int m_iUsed;      // slots written so far (max MAX_SECTIONS)
	protected int m_iSerialCounter;
	protected bool m_bDirty;
	protected float m_fSinceRebuild;
	protected int m_iRebuilds;

	//------------------------------------------------------------------------------------------------
	void MUD_RutTrailEntity(IEntitySource src, IEntity parent)
	{
		SetEventMask(EntityEvent.FRAME);
		m_Indices = new MUD_RutTrailIndices();
		for (int i = 0; i < MAX_SECTIONS; i++)
		{
			m_aPrevSlot[i] = -1;
		}
	}

	//------------------------------------------------------------------------------------------------
	protected override void EOnFrame(IEntity owner, float timeSlice)
	{
		BaseWorld world = GetWorld();
		if (!world)
			return;

		// idea 4: work only around the camera, whatever the map size
		vector camMat[4];
		world.GetCurrentCamera(camMat);
		m_aFound.Clear();
		world.QueryEntitiesBySphere(camMat[3], m_fRadius, AddEntity);

		foreach (IEntity ent : m_aFound)
		{
			VehicleWheeledSimulation sim = VehicleWheeledSimulation.Cast(ent.FindComponent(VehicleWheeledSimulation));
			if (!sim || !sim.IsValid())
				continue;

			MUD_RutVehicle veh = FindVehicle(ent);
			int count = sim.WheelCount();
			while (veh.m_aWheels.Count() < count)
			{
				veh.m_aWheels.Insert(new MUD_RutWheel());
			}

			for (int w = 0; w < count; w++)
			{
				MUD_RutWheel wheel = veh.m_aWheels[w];
				if (!sim.WheelHasContact(w))
				{
					wheel.m_iSlot = -1; // airborne: next contact starts a new chain
					continue;
				}

				vector p = sim.WheelGetContactPosition(w);
				if (wheel.m_iSlot < 0)
				{
					// first point of a chain only sets the start, no geometry yet
					wheel.m_vLast = p;
					wheel.m_iSlot = AddSection(world, p, vector.Forward, wheel, -1, -1);
					continue;
				}

				vector d = p - wheel.m_vLast;
				d[1] = 0;
				float len = d.Length();
				if (len < m_fStep)
					continue;

				vector dir = d * (1 / len);
				wheel.m_fDist += len;
				int prevSlot = wheel.m_iSlot;
				int prevSerial = wheel.m_iSerial;
				// re-orient the chain start once we know the travel direction
				if (m_aPrevSlot[prevSlot] < 0 && m_aSerial[prevSlot] == prevSerial)
					WriteSection(world, prevSlot, wheel.m_vLast, dir, wheel.m_fDist - len);

				wheel.m_vLast = p;
				wheel.m_iSlot = AddSection(world, p, dir, wheel, prevSlot, prevSerial);
			}
		}

		m_fSinceRebuild += timeSlice;
		if (m_bDirty && m_fSinceRebuild >= m_fRebuildInterval)
			Rebuild();
	}

	//------------------------------------------------------------------------------------------------
	protected bool AddEntity(IEntity e)
	{
		m_aFound.Insert(e);
		return true;
	}

	//------------------------------------------------------------------------------------------------
	protected MUD_RutVehicle FindVehicle(IEntity ent)
	{
		foreach (MUD_RutVehicle v : m_aVehicles)
		{
			if (v.m_Ent == ent)
				return v;
		}

		MUD_RutVehicle veh = new MUD_RutVehicle();
		veh.m_Ent = ent;
		m_aVehicles.Insert(veh);
		return veh;
	}

	//------------------------------------------------------------------------------------------------
	//! Takes the next ring slot, writes the cross-section, links it to the previous one
	protected int AddSection(BaseWorld world, vector p, vector dir, MUD_RutWheel wheel, int prevSlot, int prevSerial)
	{
		int slot = m_iNext;
		m_iNext = (m_iNext + 1) % MAX_SECTIONS;
		if (m_iUsed < MAX_SECTIONS)
			m_iUsed++;

		m_iSerialCounter++;
		m_aSerial[slot] = m_iSerialCounter;
		m_aPrevSlot[slot] = prevSlot;
		m_aPrevSerial[slot] = prevSerial;
		wheel.m_iSerial = m_iSerialCounter;

		WriteSection(world, slot, p, dir, wheel.m_fDist);
		return slot;
	}

	//------------------------------------------------------------------------------------------------
	//! 5 points left to right: edge, berm, centre, berm, edge. Heights follow the terrain.
	protected void WriteSection(BaseWorld world, int slot, vector p, vector dir, float dist)
	{
		// right of travel: for dir +Z this is +X, matching the tile's working winding
		vector right = Vector(dir[2], 0, -dir[0]);

		float offs[] = {-m_fStripHalfWidth, -m_fRutHalfWidth - (m_fStripHalfWidth - m_fRutHalfWidth) * 0.5, 0, m_fRutHalfWidth + (m_fStripHalfWidth - m_fRutHalfWidth) * 0.5, m_fStripHalfWidth};
		float lift[] = {m_fGroundOffset, m_fBermHeight, m_fGroundOffset, m_fBermHeight, m_fGroundOffset};

		// V ping-pongs 0..1..0 along the strip: UVs must stay inside 0..1
		float t = dist / m_fTexLength;
		t = t - Math.Floor(t);
		float v = t * 2;
		if (v > 1)
			v = 2 - v;

		for (int i = 0; i < SECTION_VERTS; i++)
		{
			vector wp = p + right * offs[i];
			wp[1] = world.GetSurfaceY(wp[0], wp[2]) + lift[i];
			int idx = slot * SECTION_VERTS + i;
			m_aVerts[idx] = CoordToLocal(wp);
			m_aUVs[idx * 2] = i * 0.25;
			m_aUVs[idx * 2 + 1] = v;
		}

		m_bDirty = true;
	}

	//------------------------------------------------------------------------------------------------
	protected void Rebuild()
	{
		// quads between every section and its still-valid previous section
		int n;
		for (int s = 0; s < m_iUsed; s++)
		{
			int prev = m_aPrevSlot[s];
			if (prev < 0 || m_aSerial[prev] != m_aPrevSerial[s])
				continue; // chain start, or the previous section was recycled

			for (int i = 0; i < SECTION_VERTS - 1; i++)
			{
				int bl = prev * SECTION_VERTS + i;
				int br = bl + 1;
				int tl = s * SECTION_VERTS + i;
				int tr = tl + 1;

				m_Indices.m_aIndices[n] = bl; n++;
				m_Indices.m_aIndices[n] = tl; n++;
				m_Indices.m_aIndices[n] = tr; n++;

				m_Indices.m_aIndices[n] = tr; n++;
				m_Indices.m_aIndices[n] = br; n++;
				m_Indices.m_aIndices[n] = bl; n++;
			}
		}

		m_bDirty = false;
		m_fSinceRebuild = 0;
		if (n == 0)
			return;

		int numVertices[] = {m_iUsed * SECTION_VERTS};
		int numIndices[] = {n};
		string materials[] = {m_Material};

		Resource res = MeshObject.Create(1, numVertices, numIndices, materials, 0);
		if (!res || !res.GetResource())
		{
			Print(string.Format("MUD: rut trail Create failed - material '%1' did not load?", m_Material), LogLevel.ERROR);
			return;
		}

		MeshObject mesh = res.GetResource().ToMeshObject();
		mesh.UpdateIndices(0, m_Indices.m_aIndices);
		mesh.UpdateVerts(0, m_aVerts, m_aUVs);
		SetObject(mesh, "");
		m_MeshRes = res;

		m_iRebuilds++;
		if (m_bDebug && m_iRebuilds % 50 == 1)
			Print(string.Format("MUD: rut trail rebuild #%1, %2 sections, %3 triangles", m_iRebuilds, m_iUsed, n / 3));
	}
}
